#!/usr/bin/env python3
import os, time, signal, sys

running = True
signal.signal(signal.SIGINT, lambda s,f: sys.exit(0))
signal.signal(signal.SIGTERM, lambda s,f: sys.exit(0))

fb0 = open('/dev/fb0', 'rb')
fb2 = open('/dev/fb2', 'wb')

print("Minimal fbcp: 16-bit direct copy (10 FPS)")

try:
    while running:
        fb0.seek(0)
        data = fb0.read(480 * 320 * 2)  # 16-bit = 2 bytes per pixel
        fb2.seek(0)
        fb2.write(data)
        fb2.flush()
        time.sleep(0.1)  # 10 FPS
except KeyboardInterrupt:
    pass
except Exception as e:
    print(f"Error: {e}")
finally:
    fb0.close()
    fb2.close()
    print("fbcp stopped")
